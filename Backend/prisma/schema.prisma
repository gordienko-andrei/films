// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  name         String?
  avatar       String?
  role         String        @default("USER")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reviews      Review[]
  ratings      Rating[]
  userEmotions UserEmotion[]
}

model Movie {
  id             String            @id @default(uuid())
  externalId     String?           @unique
  title          String
  description    String
  year           Int
  director       String
  genre          String
  posterUrl      String?  // deprecated
  posterPath     String?
  trailerUrl     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  reviews        Review[]
  ratings        Rating[]
  tags           MovieTag[]
  collections    MovieCollection[]
  filmEmotions   FilmEmotion[]
  userEmotions   UserEmotion[]
  // embeddings
  embedding      MovieEmbedding?
  similarsFrom   MovieSimilar[] @relation("SimFrom")
  similarsTo     MovieSimilar[] @relation("SimTo")
}

model Review {
  id        Int            @id @default(autoincrement())
  content   String
  rating    Int            // Общая оценка фильма
  pros      String[]       @default([])  // Что понравилось
  cons      String[]       @default([])  // Что не понравилось
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id])
  userId    Int
  movie     Movie          @relation(fields: [movieId], references: [id])
  movieId   String
  criteria  ReviewCriteria[]
  tags      ReviewTag[]
  metadata  ReviewMetadata?
  @@unique([userId, movieId])
}

model ReviewCriteria {
  id        Int      @id @default(autoincrement())
  name      String?  // Название критерия (если нет templateId)
  score     Int      // Оценка по критерию (1-10)
  comment   String?  // Комментарий по критерию
  review    Review   @relation(fields: [reviewId], references: [id])
  reviewId  Int
  templateId Int?
  template  ReviewCriterionTemplate? @relation(fields: [templateId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rating {
  id        Int      @id @default(autoincrement())
  score     Int      // Общая оценка фильма
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  movie     Movie    @relation(fields: [movieId], references: [id])
  movieId   String

  @@unique([userId, movieId])
}

model Tag {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  movies    MovieTag[]
}

model MovieTag {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  movie     Movie    @relation(fields: [movieId], references: [id])
  movieId   String
  tag       Tag      @relation(fields: [tagId], references: [id])
  tagId     Int

  @@unique([movieId, tagId])
}

model Collection {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  type        String          // Оставляем как строку
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  movies      MovieCollection[]
}

model MovieCollection {
  id           Int        @id @default(autoincrement())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  movie        Movie      @relation(fields: [movieId], references: [id])
  movieId      String
  collection   Collection @relation(fields: [collectionId], references: [id])
  collectionId Int

  @@unique([movieId, collectionId])
}

model Emotion {
  id           Int           @id @default(autoincrement())
  name         String
  emoji        String
  slug         String        @unique

  // Relations
  filmEmotions  FilmEmotion[]
  userEmotions  UserEmotion[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("emotions")
}

model FilmEmotion {
  filmId      String
  emotionId   Int
  count       Int           @default(0)
  film        Movie         @relation(fields: [filmId], references: [id])
  emotion     Emotion       @relation(fields: [emotionId], references: [id])

  @@id([filmId, emotionId])
  @@map("film_emotions")
}

model UserEmotion {
  userId      Int
  filmId      String
  emotionId   Int
  user        User          @relation(fields: [userId], references: [id])
  film        Movie         @relation(fields: [filmId], references: [id])
  emotion     Emotion       @relation(fields: [emotionId], references: [id])
  createdAt   DateTime      @default(now())

  @@id([userId, filmId, emotionId])
  @@map("user_emotions")
}

enum Role {
  USER
  ADMIN
}

enum CollectionType {
  POPULAR
  TRENDING
  RECOMMENDED
  SIMILAR
  USER_BASED
  CONTENT_BASED
  REVIEW_BASED
  CRITERIA_BASED
  TAG_BASED
  PROS_BASED
  CONS_BASED
}

model MovieEmbedding {
  movieId    String   @id
  movie      Movie    @relation(fields: [movieId], references: [id])
  vector     Json
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model MovieSimilar {
  fromId   String
  toId     String
  score    Float
  from     Movie   @relation("SimFrom", fields: [fromId], references: [id])
  to       Movie   @relation("SimTo", fields: [toId], references: [id])
  createdAt DateTime @default(now())

  @@id([fromId, toId])
  @@index([fromId])
  @@index([toId])
}

// Предопределенные шаблоны критериев для унификации
model ReviewCriterionTemplate {
  id          Int      @id @default(autoincrement())
  name        String   @unique  // "Сюжет", "Актерская игра"
  category    String   // "story", "acting", "technical"
  weight      Float    @default(1.0)
  isRequired  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  criteria    ReviewCriteria[]
}

// Теги для отзывов (для группировки)
model ReviewTag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  category  String   // "mood", "genre-feel", "audience"
  reviews   Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Метаданные отзыва для анализа и ML
model ReviewMetadata {
  id              Int      @id @default(autoincrement())
  reviewId        Int      @unique
  review          Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  sentimentScore  Float?   // -1 до 1
  keyPhrases      String[] @default([])
  embedding       Json?    // Vector embedding для ML
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
