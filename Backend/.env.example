# Copy to .env and replace placeholders. See Backend/README.md for production.

# --- Database (required) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# --- Auth (required) ---
JWT_SECRET="replace-with-a-long-random-secret"
# JWT module accepts either name (both optional only if you rely on code defaults; production should set one):
JWT_EXPIRES_IN="1d"
# JWT_EXPIRATION="1d"

# --- HTTP server ---
PORT=3000
NODE_ENV="development"

# --- CORS & cookies ---
# Browser origin(s) of the Angular app, comma-separated. Required when NODE_ENV=production.
# Example production: FRONTEND_URL="https://reviewflix.example.com"
FRONTEND_URL="http://localhost:4200"
# lax | strict | none — use none when frontend and API are on different sites (HTTPS only).
COOKIE_SAME_SITE="lax"

# --- External APIs (required for movie features) ---
TMDB_API_KEY="replace-with-tmdb-api-key"
YOUTUBE_API_KEY="replace-with-youtube-api-key"

# --- Optional ---
# Swagger at /api — disabled in production unless set to true
ENABLE_SWAGGER="false"
